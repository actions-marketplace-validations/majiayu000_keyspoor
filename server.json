{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.majiayu000/keyspoor",
  "title": "Keyspoor",
  "description": "Offline secret scanning for AI agents. Redacted findings; scans text and files in a chosen root.",
  "repository": {
    "url": "https://github.com/majiayu000/keyspoor",
    "source": "github"
  },
  "version": "0.1.4",
  "websiteUrl": "https://majiayu000.github.io/keyspoor/",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "keyspoor",
      "version": "0.1.4",
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "--yes"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "Absolute path to the project directory the agent may scan.",
          "format": "filepath",
          "isRequired": true
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
